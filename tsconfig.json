{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "types": [
            "vite/client",
            "bun-types"
        ],
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true
    }
}
